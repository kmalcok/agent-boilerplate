# =============================================================================
# TR: Bu dosyayi `.env` olarak kopyalayin ve degerleri doldurun.
# EN: Copy this file to `.env` and fill in the values.
#     cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# TR: Model saglayicisi secimi. / EN: Model provider selection.
#     openai     -> api.openai.com (default)
#     azure      -> Azure OpenAI / Azure AI Foundry
#     compatible -> OpenAI-compatible endpoint (vLLM, NVIDIA Triton, Together AI,
#                   Ollama, LM Studio, OpenRouter, ...)
# -----------------------------------------------------------------------------
MODEL_PROVIDER=openai

# TR: Tum agentlar icin varsayilan model adi. / EN: Default model name for all agents.
AGENT_MODEL=gpt-5.5

# TR: Loglama seviyesi (DEBUG/INFO/WARNING). / EN: Log level.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# TR: 1) OpenAI (MODEL_PROVIDER=openai)
# EN: 1) OpenAI (MODEL_PROVIDER=openai)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# TR: Opsiyonel; proxy/gateway icin. / EN: Optional; for a proxy/gateway.
# OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# TR: 2) OpenAI-compatible (vLLM / Triton / Together AI / Ollama ...)
# EN: 2) OpenAI-compatible (vLLM / Triton / Together AI / Ollama ...)
#     MODEL_PROVIDER=compatible
# -----------------------------------------------------------------------------
# TR: Ornek / EN: Examples:
#   vLLM:        http://localhost:8000/v1
#   Triton+vLLM: http://localhost:9000/v1
#   Together AI: https://api.together.xyz/v1
COMPATIBLE_BASE_URL=http://localhost:8000/v1
COMPATIBLE_API_KEY=EMPTY
# TR: On-prem modellerin cogu Responses API'yi desteklemez -> chat_completions.
# EN: Most on-prem models do not support the Responses API -> chat_completions.
COMPATIBLE_API_MODE=chat_completions

# -----------------------------------------------------------------------------
# TR: 3) Azure OpenAI / Azure AI Foundry (MODEL_PROVIDER=azure)
# EN: 3) Azure OpenAI / Azure AI Foundry (MODEL_PROVIDER=azure)
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
# TR: Azure'da model adi degil, "deployment" adi kullanilir. / EN: Azure uses the "deployment" name, not the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# -----------------------------------------------------------------------------
# TR: Tracing (gozlemlenebilirlik). / EN: Tracing (observability).
#     OpenAI disi saglayicilarda tracing'i kapatmak yaygin bir pratiktir.
#     It is common to disable tracing for non-OpenAI providers.
# -----------------------------------------------------------------------------
TRACING_DISABLED=false
# TR: Sadece trace yuklemek icin ayri OpenAI anahtari (opsiyonel).
# EN: Separate OpenAI key only for uploading traces (optional).
# TRACING_EXPORT_API_KEY=sk-...
WORKFLOW_NAME=agent-boilerplate

# -----------------------------------------------------------------------------
# TR: Oturum (session) backendi. / EN: Session backend.
#     memory -> in-memory SQLite (default), sqlite -> file, redis -> RedisSession
# -----------------------------------------------------------------------------
SESSION_BACKEND=memory
SESSION_DB_PATH=conversations.db
# REDIS_URL=redis://localhost:6379/0
